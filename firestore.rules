rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}
// Fields:
//   - displayName: string (optional, 1..100 chars)
//   - followersCount: int (optional, >= 0)
//   - followingCount: int (optional, >= 0)
//   - postsCount: int (optional, >= 0)
//
// Subcollection: users/{userId}/following/{friendId}
// Fields:
//   - uid: string (optional, 1..128 chars)
//   - displayName / name / username: string (optional, 1..100 chars)
//   - photoUrl / avatarUrl: string (optional, <= 1000 chars)
//
// Subcollection: users/{userId}/notifications/{notificationId}
// Fields (activity notifications):
//   - actorId: string (required, == request.auth.uid)
//   - actorName: string (required, 1..100 chars)
//   - postId: string (required, 1..100 chars)
//   - type: string (required, in ['LIKE', 'COMMENT', 'TAG'])
//   - createdAt: timestamp (required, == request.time)
// Fields (admin warning notifications, admin-only):
//   - actorId: string (required, == request.auth.uid)
//   - actorName: string (required, 1..100 chars)
//   - postId: string (optional, 0..100 chars)
//   - type: string (required, == 'WARNING')
//   - title: string (required, 1..120 chars)
//   - description: string (required, 0..1000 chars)
//   - createdAt: timestamp (required, == request.time)
//
// Collection: reports/{reportId}
// Fields:
//   - type: string (required, in ['POST', 'COMMENT', 'LOCATION', 'ACCOUNT'])
//   - status: string (required, 'PENDING' on create; admin may transition to 'IGNORED', 'RESOLVED_DELETED', 'RESOLVED_WARNED')
//   - reportedUserId: string (optional, 0..128 chars)
//   - reportedUsername: string (required, 1..100 chars)
//   - reporterUserId: string (required, == request.auth.uid)
//   - reporterUsername: string (required, 1..100 chars)
//   - reportCategory: string (required, 1..120 chars)
//   - reportDescription: string (optional, 0..1000 chars)
//   - contentPreview: string (optional, 0..500 chars)
//   - thumbnailUrl: string (optional, 0..1000 chars)
//   - postDocumentId: string (optional, 0..128 chars)
//   - postTime: string (optional, 0..64 chars)
//   - likesCount, commentsCount, sharesCount: int (optional, >= 0)
//   - createdAt: timestamp (required, == request.time)
//   - resolvedBy: string (admin update only, == request.auth.uid)
//   - resolvedByName: string (admin update only, 1..100 chars)
//   - resolvedAt: timestamp (admin update only, == request.time)
//   - warningTitle: string (admin update only, 0..120 chars)
//   - warningDescription: string (admin update only, 0..1000 chars)
//   - warningNotificationId: string (admin update only, 0..128 chars)
//   - warningRecipientUid: string (admin update only, 0..128 chars)
//   - deletedPostBackup: map (admin update only, snapshot of deleted post for restore)
//
// Subcollection: users/{userId}/streak_days/{dateKey}
// Fields:
//   - dateKey: string (required, == dateKey, format YYYY-MM-DD)
//   - workoutCompleted: bool (required)
//   - stepDistanceMeters: number (required, 0..500000)
//   - qualified: bool (required, == workoutCompleted || stepDistanceMeters >= 1000)
//   - updatedAt: timestamp (optional)
//
// Collection: reports/{reportId}
// Fields:
//   - type: string (required, in ['POST', 'COMMENT', 'LOCATION', 'ACCOUNT'])
//   - status: string (required, 'PENDING' on create; admin may transition to 'IGNORED', 'RESOLVED_DELETED', 'RESOLVED_WARNED')
//   - reportedUserId: string (optional, 0..128 chars, != request.auth.uid)
//   - reportedUsername: string (required, 1..100 chars)
//   - reporterUserId: string (required, == request.auth.uid)
//   - reporterUsername: string (required, 1..100 chars)
//   - reportCategory: string (required, 1..120 chars)
//   - reportDescription: string (optional, 0..1000 chars)
//   - contentPreview: string (optional, 0..500 chars)
//   - thumbnailUrl: string (optional, 0..1000 chars)
//   - postDocumentId: string (optional, 0..128 chars)
//   - postTime: string (optional, 0..64 chars)
//   - likesCount, commentsCount, sharesCount: int (optional, >= 0)
//   - createdAt: timestamp (required, == request.time)
//   - resolvedBy: string (admin update only, == request.auth.uid)
//   - resolvedByName: string (admin update only, 1..100 chars)
//   - resolvedAt: timestamp (admin update only, == request.time)
//   - warningTitle: string (admin update only, 0..120 chars)
//   - warningDescription: string (admin update only, 0..1000 chars)
//   - warningNotificationId: string (admin update only, 0..128 chars)
//   - warningRecipientUid: string (admin update only, 0..128 chars)
//   - deletedPostBackup: map (admin update only, snapshot of deleted post for restore)
//
// Collection: posts/{postId}
// Fields:
//   - authorId: string (required, == request.auth.uid, immutable)
//   - authorName: string (required, 1..100 chars, immutable)
//   - caption: string (required, 1..2000 chars, owner-editable)
//   - category: string (optional, 0..200 chars, immutable)
//   - searchKeywords: list<string> (optional, <= 100 items, owner-editable)
//   - imageUrl: string (optional, <= 1000 chars, immutable)
//   - taggedFriendIds: list<string> (optional, <= 50 items, owner-editable)
//   - taggedFriends: list<map> (optional, <= 50 items, owner-editable)
//   - likes: int (optional, >= 0)
//   - likedByIds: list<string> (optional, <= 500 items)
//   - likedByNames: list<string> (optional, <= 500 items)
//   - comment: int (optional, >= 0)
//   - lastCommentId: string (optional, 20 chars)
//   - Share: int (optional, >= 0)
//   - createdAt: timestamp (required, == request.time, immutable)
//   - updatedAt: timestamp (optional, == request.time on owner edit)
//
// Collection: workout_exercises/{exerciseId}
// Fields:
//   - id: string (required, == exerciseId, 1..60 chars)
//   - name: string (required, 1..80 chars)
//   - description: string (required, 1..500 chars)
//   - category: string (required, 1..60 chars)
//   - illustrationKey: string (required, 1..60 chars)
//   - defaultMode: string (required, in ['REPETITIONS', 'DURATION'])
//   - defaultTargetValue: int (required, 1..3600)
//   - steps: list<string> (required, 1..15 items)
//   - order: int (required, 1..1000)
//   - isActive: bool (required)
//   - updatedAt: timestamp (optional, == request.time)
//
// Collection: guided_workout_days/{dayId}
// Fields:
//   - dayNumber: int (required, 1..30)
//   - title: string (required, 1..80 chars)
//   - description: string (required, 1..500 chars)
//   - calories: int (required, 1..2000)
//   - durationLabel: string (required, 1..30 chars)
//   - difficultyLabel: string (required, in ['Mudah', 'Sedang', 'Menantang'])
//   - exercises: list<map> (required, 1..30 items)
//   - isActive: bool (required)
//   - updatedAt: timestamp (optional, == request.time)
//
// Collection: chats/{chatId}
// Fields:
//   - name: string (required, 1..100 chars)
//   - isGroup: bool (required)
//   - statusOrMembers, lastMessage, dateLabel: string (optional)
//   - participantIds, participantNames: list<string> (optional)
//   - updatedAt: timestamp (optional)
//
// Subcollection: chats/{chatId}/messages/{messageId}
// Fields:
//   - senderId: string (required, == request.auth.uid)
//   - senderName: string (required, 1..100 chars)
//   - text: string (required, 1..2000 chars)
//   - timeText: string (optional, <= 32 chars)
//   - venueInvite: map (optional, must contain non-blank title string)
//   - createdAt: timestamp (required)
//
// Collection: venues/{venueId}
// Read-only for authenticated users.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'admin';
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidNotification(data) {
      return hasRequiredFields(['actorId', 'actorName', 'postId', 'type', 'createdAt'])
        && hasOnlyAllowedFields(['actorId', 'actorName', 'postId', 'type', 'createdAt'])
        && data.actorId is string
        && data.actorId == request.auth.uid
        && data.actorName is string
        && data.actorName.size() > 0
        && data.actorName.size() <= 100
        && data.postId is string
        && data.postId.size() > 0
        && data.postId.size() <= 100
        && data.type in ['LIKE', 'COMMENT', 'TAG']
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidAdminWarningNotification(data) {
      return hasRequiredFields(['actorId', 'actorName', 'type', 'title', 'description', 'createdAt'])
        && hasOnlyAllowedFields(['actorId', 'actorName', 'postId', 'type', 'title', 'description', 'createdAt'])
        && data.actorId is string
        && data.actorId == request.auth.uid
        && data.actorName is string
        && data.actorName.size() > 0
        && data.actorName.size() <= 100
        && (!('postId' in data) || (data.postId is string && data.postId.size() <= 100))
        && data.type == 'WARNING'
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() <= 1000
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidReportSubmittedNotification(data) {
      return hasRequiredFields(['actorId', 'actorName', 'type', 'title', 'description', 'createdAt'])
        && hasOnlyAllowedFields(['actorId', 'actorName', 'postId', 'type', 'title', 'description', 'createdAt'])
        && data.actorId is string
        && data.actorId == request.auth.uid
        && data.actorName is string
        && data.actorName.size() > 0
        && data.actorName.size() <= 100
        && (!('postId' in data) || (data.postId is string && data.postId.size() <= 100))
        && data.type == 'REPORT_SENT'
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() <= 1000
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidReportCreate(data) {
      return hasRequiredFields([
          'type', 'status', 'reportedUsername', 'reporterUserId',
          'reporterUsername', 'reportCategory', 'createdAt'
        ])
        && hasOnlyAllowedFields([
          'type', 'status', 'reportedUserId', 'reportedUsername',
          'reporterUserId', 'reporterUsername', 'reportCategory',
          'reportDescription', 'contentPreview', 'thumbnailUrl',
          'postDocumentId', 'postTime', 'likesCount', 'commentsCount',
          'sharesCount', 'createdAt'
        ])
        && data.type in ['POST', 'COMMENT', 'LOCATION', 'ACCOUNT']
        && data.status == 'PENDING'
        && (!('reportedUserId' in data) || (data.reportedUserId is string && data.reportedUserId.size() <= 128 && data.reportedUserId != request.auth.uid))
        && data.reportedUsername is string
        && data.reportedUsername.size() > 0
        && data.reportedUsername.size() <= 100
        && data.reporterUserId is string
        && data.reporterUserId == request.auth.uid
        && data.reporterUsername is string
        && data.reporterUsername.size() > 0
        && data.reporterUsername.size() <= 100
        && data.reportCategory is string
        && data.reportCategory.size() > 0
        && data.reportCategory.size() <= 120
        && (!('reportDescription' in data) || (data.reportDescription is string && data.reportDescription.size() <= 1000))
        && (!('contentPreview' in data) || (data.contentPreview is string && data.contentPreview.size() <= 500))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000))
        && (!('postDocumentId' in data) || (data.postDocumentId is string && data.postDocumentId.size() <= 128))
        && (!('postTime' in data) || (data.postTime is string && data.postTime.size() <= 64))
        && (!('likesCount' in data) || (data.likesCount is int && data.likesCount >= 0))
        && (!('commentsCount' in data) || (data.commentsCount is int && data.commentsCount >= 0))
        && (!('sharesCount' in data) || (data.sharesCount is int && data.sharesCount >= 0))
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidReportResolutionUpdate() {
      let next = request.resource.data;
      return resource.data.status == 'PENDING'
        && next.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolvedBy', 'resolvedByName', 'resolvedAt',
          'warningTitle', 'warningDescription',
          'warningNotificationId', 'warningRecipientUid', 'deletedPostBackup'
        ])
        && next.status in ['IGNORED', 'RESOLVED_DELETED', 'RESOLVED_WARNED']
        && next.resolvedBy is string
        && next.resolvedBy == request.auth.uid
        && (!('resolvedByName' in next) || (next.resolvedByName is string && next.resolvedByName.size() > 0 && next.resolvedByName.size() <= 100))
        && next.resolvedAt is timestamp
        && next.resolvedAt == request.time
        && (!('warningTitle' in next) || (next.warningTitle is string && next.warningTitle.size() <= 120))
        && (!('warningDescription' in next) || (next.warningDescription is string && next.warningDescription.size() <= 1000))
        && (!('warningNotificationId' in next) || (next.warningNotificationId is string && next.warningNotificationId.size() <= 128))
        && (!('warningRecipientUid' in next) || (next.warningRecipientUid is string && next.warningRecipientUid.size() <= 128))
        && (!('deletedPostBackup' in next) || next.deletedPostBackup is map);
    }

    function isValidReportRestoreUpdate() {
      let next = request.resource.data;
      return resource.data.status in ['IGNORED', 'RESOLVED_DELETED', 'RESOLVED_WARNED']
        && next.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolvedBy', 'resolvedByName', 'resolvedAt',
          'warningTitle', 'warningDescription',
          'warningNotificationId', 'warningRecipientUid', 'deletedPostBackup'
        ])
        && next.status == 'PENDING';
    }

    function isValidPostCreate(data) {
      return hasRequiredFields(['authorId', 'authorName', 'caption', 'createdAt'])
        && hasOnlyAllowedFields([
          'authorId', 'authorName', 'caption', 'category', 'searchKeywords',
          'imageUrl', 'taggedFriendIds', 'taggedFriends', 'createdAt',
          'likes', 'likedByIds', 'likedByNames', 'comment', 'Share'
        ])
        && data.authorId is string
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 100
        && data.caption is string
        && data.caption.size() <= 2000
        && (!('category' in data) || (data.category is string && data.category.size() <= 200))
        && (!('searchKeywords' in data) || (data.searchKeywords is list && data.searchKeywords.size() <= 100))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('taggedFriendIds' in data) || (data.taggedFriendIds is list && data.taggedFriendIds.size() <= 50))
        && (!('taggedFriends' in data) || (data.taggedFriends is list && data.taggedFriends.size() <= 50))
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidAdminPostRestore(data) {
      return hasRequiredFields(['authorId', 'authorName', 'caption', 'createdAt'])
        && hasOnlyAllowedFields([
          'authorId', 'authorName', 'caption', 'category', 'searchKeywords',
          'imageUrl', 'taggedFriendIds', 'taggedFriends', 'createdAt',
          'likes', 'likedByIds', 'likedByNames', 'comment', 'Share'
        ])
        && data.authorId is string
        && data.authorId.size() > 0
        && data.authorId.size() <= 128
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 100
        && data.caption is string
        && data.caption.size() <= 2000
        && (!('category' in data) || (data.category is string && data.category.size() <= 200))
        && (!('searchKeywords' in data) || (data.searchKeywords is list && data.searchKeywords.size() <= 100))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('taggedFriendIds' in data) || (data.taggedFriendIds is list && data.taggedFriendIds.size() <= 50))
        && (!('taggedFriends' in data) || (data.taggedFriends is list && data.taggedFriends.size() <= 50))
        && (!('likes' in data) || (data.likes is int && data.likes >= 0))
        && (!('likedByIds' in data) || (data.likedByIds is list && data.likedByIds.size() <= 500))
        && (!('likedByNames' in data) || (data.likedByNames is list && data.likedByNames.size() <= 500))
        && (!('comment' in data) || (data.comment is int && data.comment >= 0))
        && (!('Share' in data) || (data.Share is int && data.Share >= 0))
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidVenueInvite(invite) {
      return invite is map
        && invite.keys().hasAll(['title'])
        && invite.keys().hasOnly([
          'venueId', 'title', 'sport', 'description',
          'imageUrl', 'latitude', 'longitude'
        ])
        && invite.title is string
        && invite.title.size() > 0
        && invite.title.size() <= 200
        && invite.title.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && (!('venueId' in invite) || (invite.venueId is string && invite.venueId.size() <= 128))
        && (!('sport' in invite) || (invite.sport is string && invite.sport.size() <= 100))
        && (!('description' in invite) || (invite.description is string && invite.description.size() <= 1000))
        && (!('imageUrl' in invite) || (invite.imageUrl is string && invite.imageUrl.size() <= 1000))
        && (!('latitude' in invite) || (invite.latitude is number && invite.latitude >= -90 && invite.latitude <= 90))
        && (!('longitude' in invite) || (invite.longitude is number && invite.longitude >= -180 && invite.longitude <= 180));
    }

    match /users/{userId} {
      function validFollowerCountUpdate() {
        let next = request.resource.data;
        let prevCount = resource.data.get('followersCount', 0);
        return isAuthenticated()
          && next.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
          && next.followersCount is int
          && next.followersCount >= 0
          && next.followersCount <= prevCount + 1
          && next.followersCount >= prevCount - 1;
      }

      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && hasOnlyAllowedFields([
          'displayName', 'username', 'name', 'bio', 'photoUrl', 'avatarUrl',
          'followersCount', 'followingCount', 'postsCount',
          'guidedHighestUnlockedDay', 'guidedCompletedDays', 'updatedAt'
        ]);
      allow update: if (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'username', 'name', 'bio', 'photoUrl', 'avatarUrl',
            'followersCount', 'followingCount', 'postsCount',
            'guidedHighestUnlockedDay', 'guidedCompletedDays', 'updatedAt'
          ]))
        || validFollowerCountUpdate();
      allow delete: if false;

      match /following/{friendId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyAllowedFields(['uid', 'displayName', 'name', 'username', 'photoUrl', 'avatarUrl', 'createdAt']);
        allow delete: if isOwner(userId);
      }

      match /followers/{followerId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(followerId)
          && hasOnlyAllowedFields(['uid', 'displayName', 'name', 'username', 'photoUrl', 'avatarUrl', 'createdAt']);
        allow delete: if isOwner(followerId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId)
          || (isAdmin() && resource.data.type == 'WARNING');
        allow create: if (isAuthenticated() && isValidNotification(request.resource.data))
          || (isOwner(userId) && isValidReportSubmittedNotification(request.resource.data))
          || (isAdmin() && isValidAdminWarningNotification(request.resource.data));
        allow update: if isAuthenticated()
          && resource.data.type != 'WARNING'
          && resource.data.type != 'REPORT_SENT'
          && resource.data.actorId == request.auth.uid
          && isValidNotification(request.resource.data);
      }

      match /custom_workouts/{workoutId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCustomWorkout(request.resource.data);
      }

      match /workout_progress/{progressId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && progressId == 'guided'
          && isValidGuidedWorkoutProgress(request.resource.data);
      }

      match /streak_days/{dateKey} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidStreakDay(request.resource.data, dateKey);
      }
    }

    match /posts/{postId} {
      function validCommentIncrement() {
        let next = request.resource.data;
        let commentPath = /databases/$(database)/documents/posts/$(postId)/comments/$(next.lastCommentId);
        return isAuthenticated()
          && next.diff(resource.data).affectedKeys().hasOnly(['comment', 'lastCommentId'])
          && next.lastCommentId is string
          && next.lastCommentId.matches('^[a-zA-Z0-9]{20}$')
          && next.comment is int
          && next.comment == resource.data.get('comment', 0) + 1
          && !exists(commentPath)
          && getAfter(commentPath).data.authorId == request.auth.uid
          && getAfter(commentPath).data.createdAt == request.time;
      }

      function validPostLikeUpdate() {
        let next = request.resource.data;
        return isAuthenticated()
          && next.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedByIds', 'likedByNames'])
          && next.likes is int
          && next.likes >= 0
          && math.abs(next.likes - resource.data.get('likes', 0)) <= 1
          && next.likedByIds is list
          && next.likedByIds.size() <= 500
          && next.likedByNames is list
          && next.likedByNames.size() <= 500;
      }

      function validPostCaptionUpdate() {
        let next = request.resource.data;
        let changed = next.diff(resource.data).affectedKeys();
        return isAuthenticated()
          && resource.data.authorId == request.auth.uid
          && changed.hasOnly([
            'caption', 'searchKeywords', 'taggedFriendIds', 'taggedFriends', 'updatedAt'
          ])
          && next.caption is string
          && next.caption.size() > 0
          && next.caption.size() <= 2000
          && next.caption.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && (!changed.hasAny(['searchKeywords']) || (next.searchKeywords is list && next.searchKeywords.size() <= 100))
          && (
            !changed.hasAny(['taggedFriendIds', 'taggedFriends'])
            || (
              'taggedFriendIds' in next
              && 'taggedFriends' in next
              && next.taggedFriendIds is list
              && next.taggedFriends is list
              && next.taggedFriendIds.size() <= 50
              && next.taggedFriends.size() <= 50
              && next.taggedFriendIds.size() == next.taggedFriends.size()
            )
          )
          && (!changed.hasAny(['updatedAt']) || next.updatedAt == request.time);
      }

      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && isValidPostCreate(request.resource.data))
        || (isAdmin() && isValidAdminPostRestore(request.resource.data));
      allow update: if validCommentIncrement() || validPostLikeUpdate() || validPostCaptionUpdate();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        function validReply() {
          let data = request.resource.data;
          let target = /databases/$(database)/documents/posts/$(postId)/comments/$(data.replyToCommentId);
          return data.replyToCommentId is string
            && data.replyToCommentId.matches('^[a-zA-Z0-9]{20}$')
            && data.replyToCommentId != commentId
            && exists(target)
            && data.replyToAuthorId is string
            && data.replyToAuthorId.size() > 0
            && data.replyToAuthorId == get(target).data.authorId
            && data.replyToAuthorName is string
            && data.replyToAuthorName == get(target).data.authorName;
        }

        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt', 'replyToCommentId', 'replyToAuthorId', 'replyToAuthorName'])
          && (
            !request.resource.data.keys().hasAny(['replyToCommentId', 'replyToAuthorId', 'replyToAuthorName'])
            || (request.resource.data.keys().hasAll(['replyToCommentId', 'replyToAuthorId', 'replyToAuthorName']) && validReply())
          )
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.lastCommentId == commentId
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.comment
            == get(/databases/$(database)/documents/posts/$(postId)).data.get('comment', 0) + 1;

        allow update, delete: if false;

        match /likes/{userId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated()
            && request.auth.uid == userId
            && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId))
            && request.resource.data.keys().hasAll(['createdAt'])
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt is timestamp
            && request.resource.data.createdAt == request.time;
          allow delete: if isAuthenticated() && request.auth.uid == userId;
          allow update: if false;
        }
      }
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && hasOnlyAllowedFields([
          'name', 'isGroup', 'statusOrMembers', 'lastMessage',
          'dateLabel', 'participantIds', 'participantNames', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.isGroup is bool;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && hasRequiredFields(['senderId', 'senderName', 'text', 'createdAt'])
          && hasOnlyAllowedFields(['senderId', 'senderName', 'text', 'timeText', 'venueInvite', 'createdAt'])
          && request.resource.data.senderId is string
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (!('timeText' in request.resource.data) || (request.resource.data.timeText is string && request.resource.data.timeText.size() <= 32))
          && (!('venueInvite' in request.resource.data) || isValidVenueInvite(request.resource.data.venueInvite))
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    function isValidWorkoutExercise(data, exerciseId) {
      return hasRequiredFields([
          'id', 'name', 'description', 'category', 'illustrationKey',
          'defaultMode', 'defaultTargetValue', 'steps', 'order', 'isActive'
        ])
        && hasOnlyAllowedFields([
          'id', 'name', 'description', 'category', 'illustrationKey',
          'defaultMode', 'defaultTargetValue', 'steps', 'order', 'isActive', 'updatedAt'
        ])
        && data.id is string
        && data.id == exerciseId
        && data.id.size() > 0
        && data.id.size() <= 60
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 500
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 60
        && data.illustrationKey is string
        && data.illustrationKey.size() > 0
        && data.illustrationKey.size() <= 60
        && data.defaultMode in ['REPETITIONS', 'DURATION']
        && data.defaultTargetValue is int
        && data.defaultTargetValue >= 1
        && data.defaultTargetValue <= 3600
        && data.steps is list
        && data.steps.size() >= 1
        && data.steps.size() <= 15
        && data.order is int
        && data.order >= 1
        && data.order <= 1000
        && data.isActive is bool
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidGuidedWorkoutDay(data, dayId) {
      return dayId.matches('^day_(0[1-9]|[12][0-9]|30)$')
        && hasRequiredFields([
          'dayNumber', 'title', 'description', 'calories',
          'durationLabel', 'difficultyLabel', 'exercises', 'isActive'
        ])
        && hasOnlyAllowedFields([
          'dayNumber', 'title', 'description', 'calories',
          'durationLabel', 'difficultyLabel', 'exercises', 'isActive', 'updatedAt'
        ])
        && data.dayNumber is int
        && data.dayNumber >= 1
        && data.dayNumber <= 30
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 500
        && data.calories is int
        && data.calories >= 1
        && data.calories <= 2000
        && data.durationLabel is string
        && data.durationLabel.size() > 0
        && data.durationLabel.size() <= 30
        && data.difficultyLabel in ['Mudah', 'Sedang', 'Menantang']
        && data.exercises is list
        && data.exercises.size() >= 1
        && data.exercises.size() <= 30
        && data.isActive is bool
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidCustomWorkout(data) {
      return hasRequiredFields([
          'name', 'calories', 'durationLabel', 'difficultyLabel', 'exercises'
        ])
        && hasOnlyAllowedFields([
          'name', 'calories', 'durationLabel', 'difficultyLabel', 'exercises', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.calories is int
        && data.calories >= 1
        && data.calories <= 5000
        && data.durationLabel is string
        && data.durationLabel.size() > 0
        && data.durationLabel.size() <= 30
        && data.difficultyLabel is string
        && data.difficultyLabel.size() > 0
        && data.difficultyLabel.size() <= 30
        && data.exercises is list
        && data.exercises.size() >= 1
        && data.exercises.size() <= 30
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidGuidedWorkoutProgress(data) {
      return hasRequiredFields(['highestUnlockedDay', 'completedDays'])
        && hasOnlyAllowedFields(['highestUnlockedDay', 'completedDays', 'updatedAt'])
        && data.highestUnlockedDay is int
        && data.highestUnlockedDay >= 1
        && data.highestUnlockedDay <= 30
        && data.completedDays is list
        && data.completedDays.size() <= 30
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidStreakDay(data, dateKey) {
      return dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && hasRequiredFields(['dateKey', 'workoutCompleted', 'stepDistanceMeters', 'qualified'])
        && hasOnlyAllowedFields(['dateKey', 'workoutCompleted', 'stepDistanceMeters', 'qualified', 'updatedAt'])
        && data.dateKey is string
        && data.dateKey == dateKey
        && data.workoutCompleted is bool
        && data.stepDistanceMeters is number
        && data.stepDistanceMeters >= 0
        && data.stepDistanceMeters <= 500000
        && data.qualified is bool
        && data.qualified == (data.workoutCompleted || data.stepDistanceMeters >= 1000)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /workout_exercises/{exerciseId} {
      allow read: if true;
      allow create, update: if (isAuthenticated() && isValidWorkoutExercise(request.resource.data, exerciseId)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /guided_workout_days/{dayId} {
      allow read: if true;
      allow create, update: if (isAuthenticated() && isValidGuidedWorkoutDay(request.resource.data, dayId)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      function isNotSelfReportedReport() {
        return !('reportedUserId' in resource.data)
          || resource.data.reportedUserId == ''
          || resource.data.reportedUserId != request.auth.uid;
      }

      allow read: if isAdmin();
      allow create: if isAuthenticated() && isValidReportCreate(request.resource.data);
      allow update: if isAdmin()
        && isNotSelfReportedReport()
        && (isValidReportResolutionUpdate() || isValidReportRestoreUpdate());
      allow delete: if isAdmin() && isNotSelfReportedReport();
    }

    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
